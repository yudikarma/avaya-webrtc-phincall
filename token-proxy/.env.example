# Intermediary Token Proxy configuration (Avaya WebRTC Connect Guide 4.0.10, pp. 28-30)
PORT=8443
HOST=0.0.0.0

# Set to "aawg" to proxy to Avaya Aura Web Gateway with mTLS, or "simulator" for local lab-free UI testing.
TOKEN_PROXY_MODE=aawg

# Target Avaya Aura Web Gateway endpoint (client apps never call this URL directly).
AAWG_BASE_URL=https://aawg.example.com:443
AAWG_TOKEN_PATH=/csa/resources/tokens

# Client certificate presented to AAWG; its FQDN must exist in AAWG's trusted hosts list.
AAWG_CLIENT_CERT_PATH=./certs/token-service-cert.pem
AAWG_CLIENT_KEY_PATH=./certs/token-service-key.pem
AAWG_CLIENT_KEY_PASSPHRASE=
AAWG_CA_CERT_PATH=./certs/aawg-ca-bundle.pem

# Optional enterprise auth key required in the X-Client-Key header from mobile/web clients.
PROXY_API_KEY=

# Allowed CORS origin for browser clients (set to your web app origin in production).
CORS_ORIGIN=*
