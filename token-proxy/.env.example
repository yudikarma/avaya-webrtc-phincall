# Hardened Intermediary Token Proxy configuration (Avaya WebRTC Connect Guide 4.0.10, pp. 28-30)
PORT=8443
# Bind to loopback by default; place behind a TLS-terminating reverse proxy or configure PROXY_TLS_* below.
HOST=127.0.0.1

# "aawg" enforces HTTPS + mTLS + PROXY_API_KEY; "simulator" is strictly for offline lab UI testing.
TOKEN_PROXY_MODE=aawg

# Target Avaya Aura Web Gateway endpoint (must be https://; Android clients never call this directly).
AAWG_BASE_URL=https://aawg.example.com:443
AAWG_TOKEN_PATH=/csa/resources/tokens

# mTLS client certificate presented to AAWG; its FQDN must exist in AAWG's trusted hosts list.
AAWG_CLIENT_CERT_PATH=./certs/token-service-cert.pem
AAWG_CLIENT_KEY_PATH=./certs/token-service-key.pem
AAWG_CLIENT_KEY_PASSPHRASE=
AAWG_CA_CERT_PATH=./certs/aawg-ca-bundle.pem

# Optional direct TLS termination on this proxy (TLS 1.2+ enforced).
PROXY_TLS_CERT_PATH=
PROXY_TLS_KEY_PATH=
PROXY_TLS_KEY_PASSPHRASE=

# Mandatory in aawg mode (>= 32 random chars). Clients pass this value in the X-Client-Key header.
PROXY_API_KEY=replace-with-at-least-32-cryptographically-random-characters

# Sliding-window rate limit per client IP.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
