<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release builds enforce TLS everywhere and trust system CAs only (blocks user-CA MitM). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
